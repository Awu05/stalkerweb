{
  "$comment": "StalkerWeb's one theme (\"Midnight Cinema\"), for the website and the apps. Edit here, then run `node theme/build.mjs`: it writes frontend/src/theme.generated.css, the apps' ui/theme/Tokens.kt and the server's viewer colours. Never edit those by hand — a test fails when they differ from this file. Each fill has the colour put on it (`on-…`); `pairs` lists every text-on-background used, and a test checks each is readable (WCAG AA: 4.5:1 for text, 3:1 for icons and other marks).",

  "color": {
    "bg":            "#141417",
    "surface":       "#1c1c20",
    "surface-2":     "#232328",
    "surface-3":     "#28282e",
    "surface-4":     "#303036",
    "border":        "#28282e",
    "border-strong": "#3c3c44",
    "outline-soft":  "#1f1f24",

    "text":          "#e8e8ec",
    "muted":         "#9696a0",

    "primary":       "#e8e8ec",
    "on-primary":    "#141417",
    "primary-hover": "#c8c8ce",
    "primary-light": "#ffffff",
    "primary-glow":  "rgba(232, 232, 236, 0.35)",
    "accent":        "#e8e8ec",
    "accent-light":  "#ffffff",

    "live":          "#ef4444",
    "live-fill":     "#dc2626",
    "on-live":       "#ffffff",
    "success":       "#5bc39d",
    "on-success":    "#0b1a14",
    "heart":         "#f43f5e",
    "warning":       "#fbbf24",
    "on-warning":    "#141417"
  },

  "pairs": [
    { "fg": "text",          "bg": "bg",        "use": "text" },
    { "fg": "text",          "bg": "surface",   "use": "text" },
    { "fg": "text",          "bg": "surface-2", "use": "text" },
    { "fg": "text",          "bg": "surface-3", "use": "text" },
    { "fg": "muted",         "bg": "bg",        "use": "text" },
    { "fg": "muted",         "bg": "surface",   "use": "text" },
    { "fg": "muted",         "bg": "surface-2", "use": "text" },
    { "fg": "muted",         "bg": "surface-3", "use": "mark" },
    { "fg": "primary-light", "bg": "surface",   "use": "text" },
    { "fg": "primary-light", "bg": "surface-3", "use": "text" },
    { "fg": "on-primary",    "bg": "primary",   "use": "text" },
    { "fg": "on-primary",    "bg": "primary-hover", "use": "text" },
    { "fg": "on-live",       "bg": "live-fill", "use": "text" },
    { "fg": "live",          "bg": "bg",        "use": "text" },
    { "fg": "live",          "bg": "surface",   "use": "text" },
    { "fg": "on-success",    "bg": "success",   "use": "text" },
    { "fg": "success",       "bg": "bg",        "use": "text" },
    { "fg": "success",       "bg": "surface",   "use": "text" },
    { "fg": "heart",         "bg": "bg",        "use": "mark" },
    { "fg": "warning",       "bg": "bg",        "use": "text" },
    { "fg": "on-warning",    "bg": "warning",   "use": "text" },
    { "fg": "bg",            "bg": "live",      "use": "text" }
  ],

  "radius": { "sm": 8, "md": 10, "lg": 12 },

  "$viewers": "The colours a viewer can pick for their avatar (the first is the Default viewer's). The build picks each one's initials colour: white while it reads, else near-black.",
  "viewers": ["#5b8def", "#e5484d", "#30a46c", "#f5a524", "#8e4ec6", "#12a594", "#e93d82", "#978365"]
}
